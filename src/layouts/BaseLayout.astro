---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SocialIcon from '../components/SocialIcon.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE, SOCIALS } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image = '/og.png' } = Astro.props;
const path = Astro.url.pathname;
const onWriting = path === '/' || path.startsWith('/blog');
const onAbout = path.startsWith('/about');
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content={description} />
  <meta name="author" content={SITE.author} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="article:author" content={SITE.author} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <title>{title === SITE.title ? SITE.title : `${title} · ${SITE.title}`}</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    jobTitle: 'Software Engineer',
    sameAs: SOCIALS.map((s) => s.href).filter((href) => !href.startsWith('mailto:')),
  })} />
  <Analytics />
</head>
<body>
  <div class="skip-link"><a href="#main">Skip to content</a></div>

  <header class="masthead">
    <div class="masthead-inner">
      <a href="/" class="wordmark">
        <span class="wordmark-main">{SITE.title}</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/" aria-current={onWriting ? 'page' : undefined}>Writing</a>
        <a href="/about" aria-current={onAbout ? 'page' : undefined}>About</a>
        <a href={SITE.resume} target="_blank" rel="noopener noreferrer">Resume</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <Subscribe compact />
      <div class="footer-bottom">
      <p class="footer-line">&copy; {new Date().getFullYear()} {SITE.author}. Written and coded by hand.</p>
      <ul class="social-links" aria-label="Social profiles">
        {SOCIALS.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="me noopener noreferrer">
              <SocialIcon name={social.label} />
              {social.label}
            </a>
          </li>
        ))}
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
  .skip-link a {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 0.75rem 1.25rem;
    z-index: 100;
  }
  .skip-link a:focus {
    left: var(--gutter);
    top: 0.5rem;
  }

  .masthead {
    border-bottom: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    background: var(--paper-raised);
    position: relative;
    z-index: 1;
  }
  .masthead-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 1.35rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .wordmark {
    text-decoration: none;
  }
  .wordmark:hover .wordmark-main { color: var(--accent); }
  .wordmark-main {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3vw, 2.15rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.025em;
    transition: color 0.15s ease;
  }
  .site-nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .site-nav a {
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  main {
    position: relative;
    z-index: 1;
  }

  .site-footer {
    border-top: 1px solid var(--rule-tint);
    background: var(--paper-tint);
    margin-top: 4rem;
    position: relative;
    z-index: 1;
  }
  .footer-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem var(--gutter) 3rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.75rem;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-line {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 30rem;
  }
  .social-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .social-links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 40rem) {
    .masthead-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.85rem;
      padding: 1.1rem var(--gutter) 0.85rem;
    }
    .site-nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.25rem;
    }
    .site-nav a {
      padding: 0.7rem 0.15rem;
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
    }
    .footer-inner {
      padding: 1.75rem var(--gutter) 2.25rem;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .social-links {
      gap: 0.35rem 1rem;
      flex-wrap: wrap;
    }
    .social-links a {
      display: inline-flex;
      align-items: center;
      min-height: 2.5rem;
      padding: 0.35rem 0;
    }
  }
</style>
