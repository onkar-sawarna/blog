---
import '../styles/global.css';
import { SITE, SOCIALS } from '../config';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <title>{title} · {SITE.title}</title>
</head>
<body>
  <div class="skip-link"><a href="#main">Skip to content</a></div>

  <header class="masthead">
    <div class="masthead-inner">
      <a href="/" class="wordmark">
        <span class="wordmark-main">{SITE.title}</span>
        <span class="wordmark-sub">{SITE.tagline}</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Writing</a>
        <a href="/about">About</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-line">&copy; {new Date().getFullYear()} {SITE.author} — written and coded by hand.</p>
      <ul class="social-links" aria-label="Social profiles">
        {SOCIALS.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="me noopener noreferrer">{social.label}</a>
          </li>
        ))}
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>

<style>
  .skip-link a {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 0.75rem 1.25rem;
    z-index: 100;
  }
  .skip-link a:focus {
    left: var(--gutter);
    top: 0.5rem;
  }

  .masthead {
    border-bottom: 1px solid var(--rule);
    background: var(--paper-raised);
    position: relative;
    z-index: 1;
  }
  .masthead-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 1.35rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .wordmark {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .wordmark-main {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .wordmark-sub {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    text-transform: lowercase;
  }
  .site-nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .site-nav a {
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
  }
  .site-nav a:hover {
    color: var(--accent-warm);
    border-bottom-color: var(--accent-warm);
  }

  main {
    position: relative;
    z-index: 1;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 4rem;
    position: relative;
    z-index: 1;
  }
  .footer-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem var(--gutter) 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-line {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 30rem;
  }
  .social-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .social-links a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .social-links a:hover {
    color: var(--accent-warm);
    border-bottom-color: var(--accent-warm);
  }

  @media (max-width: 40rem) {
    .footer-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
