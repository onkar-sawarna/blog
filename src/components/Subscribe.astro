---
import { SITE } from '../config';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const username = SITE.newsletter;
const frame = compact ? 'subscribe-frame-compact' : 'subscribe-frame';
const emailId = compact ? 'subscribe-email-compact' : 'subscribe-email';
---

{username && (
  <form
    class:list={['subscribe', compact && 'subscribe-compact']}
    action={`https://buttondown.com/api/emails/embed-subscribe/${username}`}
    method="post"
    target={frame}
    data-subscribe
  >
    <p class="subscribe-label">{compact ? 'New posts by email' : 'Get new posts by email'}</p>
    {!compact && (
      <p class="subscribe-dek">I send new posts when I publish. No extras.</p>
    )}
    <div class="subscribe-row">
      <label class="visually-hidden" for={emailId}>Email</label>
      <input
        id={emailId}
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">Subscribe</button>
    </div>
    <p class="subscribe-status" data-subscribe-status hidden></p>
    <iframe class="subscribe-frame" name={frame} title="Newsletter signup" hidden></iframe>
  </form>
)}

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-subscribe]')) {
    if (form.dataset.subscribeBound === '1') continue;
    form.dataset.subscribeBound = '1';

    const status = form.querySelector<HTMLElement>('[data-subscribe-status]');
    const iframe = form.querySelector('iframe');
    let sent = false;

    const show = (text: string) => {
      if (!status) return;
      status.hidden = false;
      status.textContent = text;
    };

    form.addEventListener('submit', () => {
      sent = true;
      show('Sending…');
    });

    iframe?.addEventListener('load', () => {
      if (!sent) return;
      form.reset();
      show('Check your inbox to confirm.');
    });
  }
</script>

<style>
  .subscribe {
    position: relative;
    margin: 0;
  }
  .subscribe-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin: 0 0 0.65rem;
  }
  .subscribe-dek {
    margin: 0 0 1rem;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }
  .subscribe-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 28rem;
  }
  .subscribe-status {
    margin: 0.7rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--accent);
  }
  .subscribe-frame {
    position: absolute;
    width: 0;
    height: 0;
    border: 0;
    overflow: hidden;
  }
  .subscribe input[type='email'] {
    flex: 1 1 12rem;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.65rem 0.8rem;
    -webkit-appearance: none;
    appearance: none;
  }
  .subscribe input[type='email']:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);
  }
  .subscribe button {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--paper);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0.65rem 1rem;
    cursor: pointer;
  }
  .subscribe button:hover {
    background: var(--accent-warm);
    border-color: var(--accent-warm);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 40rem) {
    .subscribe-row {
      flex-wrap: nowrap;
      max-width: 100%;
    }
    .subscribe input[type='email'] {
      flex: 1 1 auto;
      padding: 0.5rem 0.65rem;
      font-size: 16px;
      min-height: 2.5rem;
    }
    .subscribe button {
      flex: 0 0 auto;
      min-height: 2.5rem;
      padding: 0.5rem 0.7rem;
    }
  }
</style>
