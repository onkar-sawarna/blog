---
import { SITE } from '../config';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const username = SITE.newsletter;
---

{username && (
  <form
    class:list={['subscribe', compact && 'subscribe-compact']}
    action={`https://buttondown.com/api/emails/embed-subscribe/${username}`}
    method="post"
  >
    <p class="subscribe-label">{compact ? 'New posts by email' : 'Get new posts by email'}</p>
    {!compact && (
      <p class="subscribe-dek">I send new posts when I publish. No extras.</p>
    )}
    <div class="subscribe-row">
      <label class="visually-hidden" for={compact ? 'subscribe-email-compact' : 'subscribe-email'}>Email</label>
      <input
        id={compact ? 'subscribe-email-compact' : 'subscribe-email'}
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">Subscribe</button>
    </div>
  </form>
)}

<style>
  .subscribe {
    margin: 0;
  }
  .subscribe-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin: 0 0 0.65rem;
  }
  .subscribe-dek {
    margin: 0 0 1rem;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }
  .subscribe-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 28rem;
  }
  .subscribe input[type='email'] {
    flex: 1 1 12rem;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.65rem 0.8rem;
  }
  .subscribe input[type='email']:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);
  }
  .subscribe button {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--paper);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0.65rem 1rem;
    cursor: pointer;
  }
  .subscribe button:hover {
    background: var(--accent-warm);
    border-color: var(--accent-warm);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 40rem) {
    .subscribe-row {
      flex-direction: column;
      max-width: none;
    }
    .subscribe button {
      min-height: 2.75rem;
    }
  }
</style>
