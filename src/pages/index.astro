---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { publishedPosts } from '../lib/tags';

const posts = await publishedPosts();
---
<BaseLayout title={SITE.title}>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Writing</p>
      <h1>Notes on systems, networking, and how production actually behaves.</h1>
      <p class="hero-dek">
        Observability, distributed systems, and the patterns behind the problems,
        written down while the details are still sharp.
      </p>
    </div>
  </section>

  <section class="index">
    <PostList posts={posts} />
  </section>
</BaseLayout>

<style>
  .hero {
    margin: 0;
    padding: 4.25rem var(--gutter) 3rem;
    background: var(--paper-tint);
    border-bottom: 1px solid var(--rule-tint);
  }
  .hero-inner {
    max-width: 52rem;
    margin: 0 auto;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 1.15rem;
  }
  .eyebrow::after {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: var(--accent);
    opacity: 0.4;
  }
  .hero h1 {
    font-size: clamp(1.85rem, 4.5vw, 2.65rem);
    font-weight: 650;
    max-width: 22ch;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
  }
  .hero-dek {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 36rem;
    margin: 1.2rem 0 0;
  }

  .index {
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.25rem var(--gutter) 5rem;
  }

  @media (max-width: 40rem) {
    .hero { padding: 2.5rem var(--gutter) 2rem; }
    .hero h1 { max-width: none; }
    .index { padding: 0 var(--gutter) 3.5rem; }
  }
</style>
