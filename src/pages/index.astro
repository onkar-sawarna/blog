---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PostList from '../components/PostList.astro';
import TagStrip from '../components/TagStrip.astro';
import { SITE } from '../config';
import { publishedPosts } from '../lib/tags';

const posts = await publishedPosts();
---
<BaseLayout title={SITE.title}>
  <PageHero eyebrow="Writing" title="Notes on systems, networking, and how production actually behaves.">
    <p class="hero-dek">
      Observability, distributed systems, and the patterns behind the problems,
      written down while the details are still sharp.
    </p>
  </PageHero>

  <section class="index">
    <TagStrip />
    <PostList posts={posts} />
  </section>
</BaseLayout>

<style>
  .hero-dek {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 36rem;
    margin: 1.2rem 0 0;
  }

  .index {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.25rem var(--gutter) 5rem;
  }

  @media (max-width: 40rem) {
    .index { padding: 0 var(--gutter) 3.5rem; }
  }
</style>
