---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { readingTime } from '../lib/readingTime';

const allPosts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<BaseLayout title={SITE.title}>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Writing</p>
      <h1>Notes on systems, networking, and how production actually behaves.</h1>
      <p class="hero-dek">
        Observability, distributed systems, and the patterns behind the problems,
        written down while the details are still sharp.
      </p>
    </div>
  </section>

  <section class="index">
    {posts.length === 0 && (
      <p class="empty">Nothing published yet. The first entry is on its way.</p>
    )}
    <ol class="entries">
      {posts.map((post) => (
        <li class="entry">
          <a href={`/blog/${post.id}/`} class="entry-link">
            <div class="entry-meta">
              <span class="entry-date">{formatDate(post.data.pubDate)}</span>
              <span class="entry-time">{readingTime(post.body ?? '')}</span>
            </div>
            <div class="entry-main">
              <h2 class="entry-title">{post.data.title}</h2>
              <p class="entry-desc">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="entry-tags">
                  {post.data.tags.map((tag) => <li class="tag" data-tag={tag}>{tag}</li>)}
                </ul>
              )}
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .hero {
    margin: 0;
    padding: 4.25rem var(--gutter) 3rem;
    background: var(--paper-tint);
    border-bottom: 1px solid var(--rule-tint);
  }
  .hero-inner {
    max-width: 52rem;
    margin: 0 auto;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 1.15rem;
  }
  .eyebrow::after {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: var(--accent);
    opacity: 0.4;
  }
  .hero h1 {
    font-size: clamp(1.85rem, 4.5vw, 2.65rem);
    font-weight: 650;
    max-width: 22ch;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
  }
  .hero-dek {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 36rem;
    margin: 1.2rem 0 0;
  }

  .index {
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.25rem var(--gutter) 5rem;
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    border-bottom: 1px solid var(--rule);
  }
  .entry-link {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 1.5rem 2rem;
    align-items: start;
    text-decoration: none;
    color: inherit;
    padding: 2.15rem 0;
  }
  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.35rem;
  }
  .entry-date,
  .entry-time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .entry-date { color: var(--accent-warm); }
  .entry-time { color: var(--ink-soft); }
  .entry-title {
    font-size: 1.45rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: color 0.15s ease;
  }
  .entry-link:hover .entry-title {
    color: var(--accent-warm);
  }
  .entry-desc {
    color: var(--ink-soft);
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.55;
    max-width: 38rem;
  }
  .entry-tags {
    list-style: none;
    display: flex;
    gap: 0.4rem;
    padding: 0;
    margin: 0.85rem 0 0;
    flex-wrap: wrap;
  }
  .empty {
    color: var(--ink-soft);
    padding: 2rem 0;
  }

  @media (max-width: 40rem) {
    .hero { padding: 2.5rem var(--gutter) 2rem; }
    .hero h1 { max-width: none; }
    .index { padding: 0 var(--gutter) 3.5rem; }
    .entry-link {
      grid-template-columns: 1fr;
      gap: 0.55rem;
      padding: 1.6rem 0;
    }
    .entry-meta {
      flex-direction: row;
      gap: 0.75rem;
      padding-top: 0;
    }
    .entry-title { font-size: 1.28rem; }
  }
</style>
