---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { readingTime } from '../lib/readingTime';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<BaseLayout title={SITE.title}>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Writing</p>
      <h1>Notes on systems, networking, and how production actually behaves.</h1>
      <p class="hero-dek">
        Observability, distributed systems, and the patterns behind the problems,
        written down while the details are still sharp.
      </p>
    </div>
  </section>

  <section class="index">
    {posts.length === 0 && (
      <p class="empty">Nothing published yet. The first entry is on its way.</p>
    )}
    <ol class="entries">
      {posts.map((post) => (
        <li class="entry">
          <a href={`/blog/${post.id}/`} class="entry-link">
            <span class="entry-date">{formatDate(post.data.pubDate)} · {readingTime(post.body ?? '')}</span>
            <h2 class="entry-title">{post.data.title}</h2>
            <p class="entry-desc">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="entry-tags">
                {post.data.tags.map((tag) => <li class="tag" data-tag={tag}>{tag}</li>)}
              </ul>
            )}
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .hero {
    margin: 0;
    padding: 4.25rem var(--gutter) 3rem;
    background: var(--paper-tint);
    border-bottom: 1px solid var(--rule-tint);
  }
  .hero-inner {
    max-width: 64rem;
    margin: 0 auto;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 1.15rem;
  }
  .eyebrow::after {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: var(--accent);
    opacity: 0.4;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.15rem);
    font-weight: 650;
    max-width: 22ch;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
  .hero-dek {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 38rem;
    margin-top: 1.35rem;
  }

  .index {
    max-width: 64rem;
    margin: 0 auto;
    padding: 1rem var(--gutter) 4rem;
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    border-bottom: 1px solid var(--rule);
  }
  .entry-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 2.1rem 0;
    border-radius: 2px;
  }
  .entry-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-warm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .entry-title {
    font-size: 1.55rem;
    font-weight: 600;
    margin: 0.45rem 0 0.5rem;
    color: var(--ink);
    letter-spacing: -0.02em;
    transition: color 0.15s ease;
  }
  .entry-link:hover .entry-title {
    color: var(--accent-warm);
  }
  .entry-desc {
    color: var(--ink-soft);
    margin: 0 0 0.75rem;
    max-width: var(--measure);
  }
  .entry-tags {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }
  .entry-tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: var(--tag-bg);
    color: var(--ink-soft);
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
  }
  .empty {
    color: var(--ink-soft);
    font-style: italic;
    padding: 2rem 0;
  }

  @media (max-width: 40rem) {
    .hero {
      padding: 2rem var(--gutter) 1.75rem;
    }
    .hero h1 {
      font-size: clamp(1.7rem, 8vw, 2.15rem);
      max-width: none;
    }
    .index {
      padding: 0.25rem var(--gutter) 3rem;
    }
    .entry-link {
      padding: 1.5rem 0;
    }
    .entry-title {
      font-size: 1.3rem;
    }
  }
</style>
