---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Subscribe from '../components/Subscribe.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { SITE, SOCIALS } from '../config';

const mail = SOCIALS.find((s) => s.href.startsWith('mailto:'))?.href ?? 'mailto:onkarsawarna@gmail.com';

function socialLine(href: string) {
  if (href.startsWith('mailto:')) return href.replace('mailto:', '');
  try {
    const u = new URL(href);
    const host = u.hostname.replace(/^www\./, '');
    const path = u.pathname.replace(/\/$/, '');
    return `${host}${path}`;
  } catch {
    return href;
  }
}
---
<BaseLayout
  title="About"
  description="Onkar Sawarna, software engineer at Acceldata. Previously Menlo Security. Writing on observability, networking, and distributed systems."
  image="/og/about.png"
  hasSubscribe
>
  <PageHero eyebrow="About" title={`Hey, I am ${SITE.author.split(' ')[0]}.`}>
    <p class="hero-dek">I write the models I use when a connect fails or a metric lies.</p>
  </PageHero>

  <section class="about">
    <header class="about-intro">
      <div class="portrait-wrap">
        <img
          class="portrait"
          src="/onkar-352.jpg"
          srcset="/onkar-176.jpg 176w, /onkar-352.jpg 352w"
          sizes="(max-width: 40rem) 8.5rem, 11rem"
          alt="Onkar Sawarna"
          width="220"
          height="220"
        />
      </div>
      <div class="about-heading">
        <p class="lede">engineering, networking, observability, and distributed systems.</p>
        <ul class="about-socials" aria-label="Social profiles">
          {SOCIALS.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="me noopener noreferrer"
              >
                <SocialIcon name={social.label} />
                <span class="social-label">{social.label}</span>
                <span class="social-url">{socialLine(social.href)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <div class="about-body">
      <p>
        I am a software engineer at Acceldata. I work on observability: how you
        see a distributed system while it is running, and how you find out what
        broke before the user has to tell you.
      </p>
      <p>
        Before this I spent four years at Menlo Security. I joined as an intern and
        left as a Senior Engineer, working on cybersecurity and networking. That
        stretch taught me how production systems actually behave: latency, failure,
        and the parts of a network you only notice when they are wrong. Most of
        what I know I learned inside one codebase, slowly.
      </p>
      <p>
        I studied Mathematics and Computing at BIT Mesra. Alongside the job I have
        gone deep on DSA and system design. Hundreds of problems. The useful part
        was not the problem numbers. It was getting faster at seeing the pattern,
        and getting clearer at explaining the tradeoff.
      </p>
      <p>
        This site is where I write that down. Mental models, not solution dumps.
        Writing lives on the homepage. Longer notes are on
        <a href="/notes">Notes</a>. If something here is useful, wrong, or worth
        arguing about, <a href={mail}>write to me</a>.
      </p>
    </div>

    <div class="about-subscribe">
      <Subscribe />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-dek {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 36rem;
    margin: 1.2rem 0 0;
  }
  .about {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 2.75rem var(--gutter) 5rem;
  }
  .about-intro {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .portrait-wrap {
    width: 11rem;
    height: 11rem;
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: #899b98;
    box-shadow: 0 8px 24px rgba(22, 22, 22, 0.08);
  }
  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 48% 6%;
    transform: scale(1.45) translateY(8%);
    transform-origin: 50% 12%;
  }
  .lede {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--accent-mid);
    margin: 0;
    max-width: 28ch;
  }
  .about-heading {
    min-width: 0;
  }
  .about-socials {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .about-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid transparent;
  }
  .about-socials a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .social-label {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    min-width: 5.25rem;
  }
  .social-url {
    color: var(--ink);
  }
  @media (max-width: 40rem) {
    .about {
      padding: 2rem var(--gutter) 3.5rem;
    }
    .about-intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.15rem;
      margin-bottom: 2rem;
    }
    .portrait-wrap {
      width: 8.5rem;
      height: 8.5rem;
    }
    .lede { max-width: none; }
  }
  .about-body {
    max-width: 40rem;
  }
  .about-body p {
    font-size: 1.12rem;
    margin: 1.15em 0;
  }
  .about-body p:first-child {
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .about-subscribe {
    margin-top: 2.75rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
</style>
