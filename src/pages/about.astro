---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '../config';
---
<BaseLayout title="About">
  <section class="about">
    <p class="eyebrow">About</p>
    <h1>Hi, I'm {SITE.author}.</h1>
    <div class="about-body">
      <p>
        I'm a software engineer at Acceldata, where I've been for about five months. Before
        that I spent four years at Menlo Security — I joined as an intern and left as an
        engineer, which means most of what I know about production systems I learned inside
        one codebase, slowly, usually the hard way.
      </p>
      <p>
        Moving from an established company to a startup reset a lot of my assumptions about
        how software gets built. Alongside that, I'm working through Arpit Bhayani's system
        design masterclass, which is the first time I've studied this material deliberately
        rather than absorbing it by osmosis from whatever I happened to be on call for.
      </p>
      <p>
        This site is where both of those land. Notes on system design as I work through it,
        write-ups of problems I've actually hit, and the parts of a software career nobody
        puts in a job description. It's a working log, not a highlight reel — written while
        I'm still figuring it out rather than years after the fact.
      </p>
      <p>
        If something here is useful, wrong, or worth arguing about, I'd like to hear it.
      </p>
    </div>

    <ul class="elsewhere" aria-label="Find me elsewhere">
      {SOCIALS.map((social) => (
        <li>
          <a href={social.href} target="_blank" rel="me noopener noreferrer">{social.label}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 3.5rem var(--gutter) 5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .about h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    margin-bottom: 1.75rem;
  }
  .about-body p {
    font-size: 1.08rem;
    margin: 1.1em 0;
  }

  .elsewhere {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
  }
  .elsewhere a {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.5rem 0.9rem;
  }
  .elsewhere a:hover {
    color: var(--accent-warm);
    border-color: var(--accent-warm);
  }
</style>
