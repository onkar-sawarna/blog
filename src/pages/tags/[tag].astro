---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PostList from '../../components/PostList.astro';
import { allTags, publishedPosts, tagPath, tagSlug } from '../../lib/tags';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const tags = await allTags();
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === slug)),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props as Props;
const others = (await allTags()).filter((other) => other.slug !== tagSlug(tag));
const count = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`;
---
<BaseLayout
  title={`Tagged ${tag}`}
  description={`Posts tagged ${tag}: notes on engineering, networking, observability, and distributed systems.`}
>
  <PageHero eyebrow="Tag" title={tag}>
    <p class="hero-dek">{count}</p>
  </PageHero>

  <section class="index">
    <PostList posts={posts} empty="Nothing under this tag yet." />

    {others.length > 0 && (
      <nav class="other-tags" aria-label="Other tags">
        <p class="other-label">Other tags</p>
        <ul>
          {others.map((other) => (
            <li><a class="tag" data-tag={other.tag} href={tagPath(other.tag)}>{other.tag}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <p class="all"><a href="/">All writing</a></p>
  </section>
</BaseLayout>

<style>
  .hero-dek {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    margin: 0.85rem 0 0;
  }

  .index {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.25rem var(--gutter) 5rem;
  }

  .other-tags {
    margin-top: 2.5rem;
  }
  .other-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    margin: 0 0 0.7rem;
  }
  .other-tags ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .all {
    margin: 2.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .all a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .all a:hover {
    color: var(--accent-warm);
    border-bottom-color: var(--accent-warm);
  }

  @media (max-width: 40rem) {
    .index { padding: 0 var(--gutter) 3.5rem; }
  }
</style>
