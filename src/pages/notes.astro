---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { NOTES, SOCIALS } from '../config';

const mail = SOCIALS.find((s) => s.href.startsWith('mailto:'))?.href.replace('mailto:', '')
  ?? 'osamonke2112@gmail.com';

function rupees(s: string) {
  return Number(s.replace(/[^\d]/g, ''));
}

function discountLabel(was?: string, price?: string) {
  if (!was || !price) return '';
  const a = rupees(was);
  const b = rupees(price);
  if (!a || b >= a) return '';
  return `${Math.round((1 - b / a) * 100)}% off`;
}
---
<BaseLayout
  title="Notes"
  description="Longer notes than the blog. One subject, my models. After you pay, the file downloads."
>
  <PageHero eyebrow="Notes" title="Same models as the posts, written so you can sit with one subject.">
    <p class="hero-dek">You pay. The next page downloads the file.</p>
  </PageHero>

  <section class="notes">
    {NOTES.length === 0 ? (
      <p class="empty">
        Nothing for sale yet. If you want a longer writeup of something already on the
        site, <a href={`mailto:${mail}`}>write to me</a>.
      </p>
    ) : (
      <ul class="note-list">
        {NOTES.map((note) => {
          const href = note.buyUrl
            || `mailto:${mail}?subject=${encodeURIComponent(`Buy: ${note.title}`)}`;
          const paid = Boolean(note.buyUrl);
          const off = discountLabel(note.wasPrice, note.price);
          return (
            <li class="note">
              {note.cover && (
                <figure class="note-cover">
                  <img src={note.cover} alt={`Cover of ${note.title}`} width="420" height="560" />
                </figure>
              )}
              <div class="note-body">
                <div class="note-copy">
                  <h2>{note.title}</h2>
                  <p>{note.description}</p>
                  {note.pages != null && (
                    <p class="note-meta">{note.pages} pages</p>
                  )}
                </div>
                <div class="note-buy">
                  <p class="note-price">
                    {note.wasPrice && <s class="note-was">{note.wasPrice}</s>}
                    <span>{note.price}</span>
                    {off && <span class="note-off">{off}</span>}
                  </p>
                  {note.previewUrl && (
                    <a class="preview" href={note.previewUrl}>Preview</a>
                  )}
                  <a class="buy" href={href}>
                    {paid ? 'Buy' : 'Email to buy'}
                  </a>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )}
    <p class="note-help">
      If the file did not start, open <a href="/notes/thanks">the thanks page</a> and
      paste the payment id from the receipt.
    </p>
  </section>
</BaseLayout>

<style>
  .hero-dek {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 36rem;
    margin: 1.2rem 0 0;
  }
  .notes {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.25rem var(--gutter) 5rem;
  }
  .empty {
    color: var(--ink-soft);
    font-size: 1.08rem;
    padding-top: 2rem;
  }
  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .note {
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: 2rem 2.25rem;
    align-items: stretch;
    padding: 2.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .note-cover {
    margin: 0;
    background: var(--paper-raised);
    border: 1px solid var(--rule-tint);
    border-radius: 3px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgb(22 22 22 / 0.08);
  }
  .note-cover img {
    display: block;
    width: 100%;
    height: auto;
  }
  .note-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding: 0.15rem 0 0.1rem;
  }
  .note h2 {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .note-copy p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.5;
  }
  .note-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-warm);
    margin-top: 0.55rem !important;
  }
  .note-buy {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.4rem;
  }
  .note-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    margin: 0;
    color: var(--ink);
  }
  .note-was {
    color: var(--ink-soft);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .note-off {
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-warm);
  }
  .preview {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 0.48rem 0.95rem;
  }
  .preview:hover {
    color: var(--paper);
    background: var(--accent);
  }
  .buy {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--paper);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 0.48rem 0.95rem;
  }
  .buy:hover {
    background: var(--accent-warm);
    border-color: var(--accent-warm);
  }
  .note-help {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 2rem 0 0;
    max-width: 36rem;
  }
  @media (max-width: 40rem) {
    .notes { padding: 0 var(--gutter) 3.5rem; }
    .note {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1.75rem 0;
    }
    .note-cover {
      width: min(14rem, 70vw);
    }
  }
</style>
