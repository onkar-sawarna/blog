---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NOTES, SOCIALS } from '../config';

const mail = SOCIALS.find((s) => s.href.startsWith('mailto:'))?.href.replace('mailto:', '')
  ?? 'onkarsawarna@gmail.com';
---
<BaseLayout
  title="Notes"
  description="Longer notes than the blog. One subject, my models. After you pay, the file downloads."
>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Notes</p>
      <h1>Same models as the posts, written so you can sit with one subject.</h1>
      <p class="hero-dek">You pay. The next page downloads the file.</p>
    </div>
  </section>

  <section class="notes">
    {NOTES.length === 0 ? (
      <p class="empty">
        Nothing for sale yet. If you want a longer writeup of something already on the
        site, <a href={`mailto:${mail}`}>write to me</a>.
      </p>
    ) : (
      <ul class="note-list">
        {NOTES.map((note) => {
          const href = note.buyUrl
            || `mailto:${mail}?subject=${encodeURIComponent(`Buy: ${note.title}`)}`;
          const paid = Boolean(note.buyUrl);
          return (
            <li class="note">
              <div class="note-copy">
                <h2>{note.title}</h2>
                <p>{note.description}</p>
                {note.pages != null && (
                  <p class="note-meta">{note.pages} pages</p>
                )}
              </div>
              <div class="note-buy">
                <p class="note-price">{note.price}</p>
                <a class="buy" href={href}>
                  {paid ? 'Buy' : 'Email to buy'}
                </a>
              </div>
            </li>
          );
        })}
      </ul>
    )}
    <p class="note-help">
      If the file did not start, open <a href="/notes/thanks">the thanks page</a> and
      paste the payment id from the receipt.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    margin: 0;
    padding: 4.25rem var(--gutter) 3rem;
    background: var(--paper-tint);
    border-bottom: 1px solid var(--rule-tint);
  }
  .hero-inner {
    max-width: 48rem;
    margin: 0 auto;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 1.15rem;
  }
  .eyebrow::after {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: var(--accent);
    opacity: 0.4;
  }
  .hero h1 {
    font-size: clamp(1.85rem, 4.5vw, 2.65rem);
    font-weight: 650;
    max-width: 22ch;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
  }
  .hero-dek {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 36rem;
    margin: 1.2rem 0 0;
  }
  .notes {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0.5rem var(--gutter) 5rem;
  }
  .empty {
    color: var(--ink-soft);
    font-size: 1.08rem;
    padding-top: 2rem;
  }
  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem 1.5rem;
    align-items: start;
    padding: 1.85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .note h2 {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .note-copy p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.5;
  }
  .note-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-warm);
    margin-top: 0.55rem !important;
  }
  .note-buy {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.55rem;
    min-width: 4.5rem;
  }
  .note-price {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    margin: 0;
    color: var(--ink);
  }
  .buy {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--rule-tint);
    border-radius: 2px;
    padding: 0.4rem 0.75rem;
  }
  .buy:hover {
    color: var(--paper);
    background: var(--accent);
    border-color: var(--accent);
  }
  .note-help {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 2rem 0 0;
    max-width: 36rem;
  }
  @media (max-width: 40rem) {
    .hero { padding: 2.5rem var(--gutter) 2rem; }
    .notes { padding: 0 var(--gutter) 3.5rem; }
    .note {
      grid-template-columns: 1fr;
      padding: 1.5rem 0;
    }
    .note-buy {
      align-items: flex-start;
    }
  }
</style>
