# Optional locally. Required on Vercel for post likes to persist.
# Create a free Redis database at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Paid notes download. Key secret verifies the Razorpay redirect.
# Key id is required to look up a payment id if the redirect is lost.
# NOTES_PDF_KEY decrypts api/notes-file/computer-networks.pdf.enc
# (go run ./cmd/encrypt-note). Create the payment link with
# go run ./cmd/razorpay-link and paste buyUrl into src/config.ts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NOTES_PDF_KEY=
NOTES_PAYMENT_LINK_ID=
NOTES_REFERENCE_ID=note-computer-networks
# Comma-separated paise amounts the download API will accept.
NOTES_AMOUNT_PAISE=100,14900
